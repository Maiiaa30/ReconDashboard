# Production frontend build. Compiles the SPA to static assets and publishes them
# into a shared volume that the backend serves (single origin). This image is not
# a long-running service — it builds, copies dist into /out, and exits.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
RUN npm run build

# Minimal publisher stage: hold the built assets and copy them into the mounted
# /out volume on start, so the backend can serve them from STATIC_DIR.
FROM busybox:1.36
COPY --from=build /app/dist /dist
CMD ["sh", "-c", "rm -rf /out/* && cp -a /dist/. /out/ && echo 'SPA published to /out'"]
